package bagstructure;

public class Main {

    public static void main(String[] args) {

        Bag<String> bagOne = new Bag<>();
        Bag<String> bagTwo = new Bag<>();

        bagOne.add("Math");
        bagOne.add("Science");
        bagOne.add("Math");
        bagOne.add("English");

        bagTwo.add("History");
        bagTwo.add("Math");
        bagTwo.add("Science");
        bagTwo.add("Art");

        System.out.println("Bag One:");
        bagOne.printBag();
        System.out.println("Size of Bag One: " + bagOne.size());

        System.out.println("\nBag Two:");
        bagTwo.printBag();
        System.out.println("Size of Bag Two: " + bagTwo.size());

        bagOne.merge(bagTwo);

        System.out.println("\nMerged Bag:");
        bagOne.printBag();
        System.out.println("Size of Merged Bag: " + bagOne.size());

        Bag<String> distinctBag = bagOne.distinct();

        System.out.println("\nDistinct Bag:");
        distinctBag.printBag();
        System.out.println("Size of Distinct Bag: " + distinctBag.size());
    }
}
